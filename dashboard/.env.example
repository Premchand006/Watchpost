# Watchpost dashboard environment
# Copy to .env.local for local dev, or set these in the Vercel / Netlify
# project settings. The browser gets the anon key only, never the service key.
#
# From Supabase: Settings, API.
#   VITE_SUPABASE_URL       Project URL (https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY  the public "anon" key
#   VITE_NODE_ID            optional, edge node id shown in the top bar (default pi-01)

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# VITE_NODE_ID=pi-01
