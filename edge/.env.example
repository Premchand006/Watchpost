# Watchpost edge secrets. Copy to edge/.env and fill in. edge/.env is gitignored.
#
# From the Supabase project: Settings > API.
#  SUPABASE_URL          Project URL (https://xxxx.supabase.co)
#  SUPABASE_SERVICE_KEY  service_role key. It stays on the Pi; the dashboard uses the anon key.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
